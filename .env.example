# ------------------------------------------------------------------
# UPC AI — environment. Copy to .env.local for the web app.
# NEVER commit real values.
# ------------------------------------------------------------------

# Required
DATABASE_URL=postgres://postgres:postgres@localhost:5432/upcai

# Auth — generate with:
#   node -e "const {generateKeyPairSync}=require('crypto');const {privateKey,publicKey}=generateKeyPairSync('rsa',{modulusLength:2048});console.log(JSON.stringify({priv:privateKey.export({type:'pkcs8',format:'pem'}).replace(/\n/g,'\\n'),pub:publicKey.export({type:'spki',format:'pem'}).replace(/\n/g,'\\n')},null,2))"
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional (sensible defaults)
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google sign-in — create at console.cloud.google.com (OAuth client, Web application,
# authorized origin http://localhost:3000). Same value in BOTH variables. Secret not
# needed for the one-click ID-token flow.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
COLLEGE_EMAIL_DOMAINS=upc.ac.in

# Mail — "console" logs OTPs to server logs (dev); "resend" sends email (prod)
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=UPC AI <no-reply@upcai.in>

# AI providers — at least one enables chat
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_EMBEDDING_KEY=

# Bring-your-own models — ANY OpenAI-compatible endpoint (JSON array).
# Users only ever see the branded names UPC-1 / UPC-1 Plus / UPC-1 Pro;
# "tier" decides which branded model serves it (fast/standard/frontier).
# Optional per-entry: costPerMTokIn / costPerMTokOut (USD per 1M tokens).
#
# AI_CUSTOM_PROVIDERS=[
#   {"name":"kimi","tier":"frontier","baseUrl":"https://api.moonshot.ai/v1","apiKey":"sk-...","model":"kimi-k2-0711-preview"},
#   {"name":"glm","tier":"standard","baseUrl":"https://open.bigmodel.cn/api/paas/v4","apiKey":"...","model":"glm-4.6"},
#   {"name":"qwen","tier":"standard","baseUrl":"https://dashscope.aliyuncs.com/compatible-mode/v1","apiKey":"sk-...","model":"qwen3-max"},
#   {"name":"gemini","tier":"standard","baseUrl":"https://generativelanguage.googleapis.com/v1beta/openai","apiKey":"AI...","model":"gemini-flash-latest"},
#   {"name":"deepseek","tier":"fast","baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-...","model":"deepseek-chat"},
#   {"name":"ollama","tier":"fast","baseUrl":"http://localhost:11434/v1","apiKey":"ollama","model":"llama3.1"}
# ]
#
# More endpoints that work: OpenRouter (https://openrouter.ai/api/v1 — gives access
# to nearly every vendor model), Together, Fireworks, Groq, vLLM, LM Studio.
# Gemini tip: use the -latest aliases (gemini-flash-latest / gemini-pro-latest) —
# versioned names get retired. Pro models require a billing-enabled key.
AI_CUSTOM_PROVIDERS=[]

# Object storage (Cloudflare R2 / S3-compatible) — for document uploads
S3_ENDPOINT=
S3_BUCKET=upc-ai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
